# Copy to .env — never commit .env
DATABASE_URL="postgresql://kcmsc:change-me@localhost:5432/kcmsc?schema=public"

# 32+ random bytes, base64/hex. Used to HMAC login-rate-limit keys and IP hashes.
# Generate: openssl rand -base64 48
APP_SECRET=""

# Private file storage (photos, import sources). MUST be outside any web-served directory.
FILE_STORAGE_DIR="./storage"

# Session lifetime in hours (absolute) and idle timeout in minutes
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Set true ONLY behind your own reverse proxy that overwrites X-Forwarded-For (enables per-IP rate limits)
TRUST_PROXY=false

# Login rate limiting / lockout
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# One-time seed: provisions the Principal under the LEADER role. Used only by `npm run db:seed`;
# remove after first run. The seed prints a random temporary password once; it is never read from env.
SEED_PRINCIPAL_STAFF_ID=""
SEED_PRINCIPAL_NAME=""
SEED_ADMIN_STAFF_ID=""
SEED_ADMIN_NAME=""

# Optional: email-based account recovery. All three must be set to enable it; otherwise recovery is admin-issued only.
APP_URL="https://staff.example.org"
SMTP_URL=""   # e.g. smtps://user:pass@smtp.example.org:465
MAIL_FROM="KCMSC Staff <no-reply@example.org>"
