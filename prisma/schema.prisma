// KCMSC Staff Management — database schema (PostgreSQL)
// Design rules:
//  - StaffMember is never deleted (DB trigger in prisma/sql/db_guards.sql).
//  - Employment status (StaffMember.employmentStatus) is separate from login status (UserAccount.accountStatus).
//  - Confidential observation text lives ONLY in LeaderObservation / ObservationRevision / ImportObservationRow.
//  - Passwords are stored only as Argon2id hashes. Sessions/reset tokens store SHA-256 hashes only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  RETIRED
  TERMINATED
  CONTRACT_ENDED
}

enum AccountStatus {
  PENDING_ACTIVATION // temp credential issued, never logged in
  ACTIVE
  LOCKED // automatic lockout after repeated failures
  DISABLED // manually disabled by an authorised admin
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum EducationLevel {
  SECONDARY
  HIGHER_SECONDARY
  GRADUATION
  MASTERS
  BED_MED
  NTRCA
  OTHER // "Name of Others Degree/Training" — title field names it; may repeat
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // withdrawn by the employee
}

enum ChangeTarget {
  STAFF_FIELD
  EDUCATION
  EXPERIENCE
  PHOTO
}

enum FilePurpose {
  PROFILE_PHOTO
  IMPORT_SOURCE
}

enum ImportStatus {
  UPLOADED
  MAPPED
  VALIDATED
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  CONFLICT // matches an existing record with different data — never auto-merged
  COMMITTED
  SKIPPED
}

enum IssueSeverity {
  ERROR
  WARNING
}

// ───────────────────────── Reference data ─────────────────────────

model Department {
  id        String        @id @default(cuid())
  name      String        @unique
  isActive  Boolean       @default(true)
  staff     StaffMember[]
  scopedTo  UserRole[]
  createdAt DateTime      @default(now())
}

model Designation {
  id        String        @id @default(cuid())
  name      String        @unique
  isActive  Boolean       @default(true)
  staff     StaffMember[]
  createdAt DateTime      @default(now())
}

// "Joined As" on the profile sheet (e.g. Permanent, Probationary, Part-time)
model EmploymentCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  isActive  Boolean       @default(true)
  staff     StaffMember[]
  createdAt DateTime      @default(now())
}

// ───────────────────────── Staff ─────────────────────────

model StaffMember {
  id                  String             @id @default(cuid())
  staffId             String             @unique // "ID No." — login identifier
  name                String
  designationId       String?
  categoryId          String? // "Joined As"
  departmentId        String?
  joiningDate         DateTime?          @db.Date
  dateOfBirth         DateTime?          @db.Date
  subject             String? // Academic discipline / subject
  additionalQualifications String?       @db.Text
  mobile              String?
  email               String?
  maritalStatus       MaritalStatus?
  bloodGroup          BloodGroup?
  homeDistrict        String?
  nidOrPassport       String? // sensitive: never in lists, charts, logs or exports
  presentAddress      String?            @db.Text
  permanentAddress    String?            @db.Text
  photoFileId         String?            @unique
  employmentStatus    EmploymentStatus   @default(ACTIVE)
  // Optimistic concurrency: incremented on every official-record write.
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  designation Designation?       @relation(fields: [designationId], references: [id], onDelete: Restrict)
  category    EmploymentCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  photoFile   FileAsset?         @relation("StaffPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  account       UserAccount?
  education     EducationRecord[]
  experience    ExperienceRecord[]
  changeRequests ChangeRequest[]
  statusEvents  EmploymentStatusEvent[]
  observation   LeaderObservation?
  ownedFiles    FileAsset[]        @relation("FileOwner")

  @@index([employmentStatus])
  @@index([departmentId])
  @@index([designationId])
  @@index([name])
}

model EducationRecord {
  id                 String         @id @default(cuid())
  staffMemberId      String
  level              EducationLevel
  title              String? // required for OTHER (name of degree/training)
  institution        String?
  boardOrUniversity  String?
  subject            String?
  passingYear        Int?
  result             String? // GPA / marks / % (NTRCA is a percentage)
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  // One row per level except OTHER — enforced by partial unique index in db_guards.sql
  @@index([staffMemberId])
}

model ExperienceRecord {
  id            String    @id @default(cuid())
  staffMemberId String
  slot          Int // 1..3 as on the sheet (CHECK in db_guards.sql)
  organization  String?
  designation   String?
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  @@unique([staffMemberId, slot])
}

model EmploymentStatusEvent {
  id            String           @id @default(cuid())
  staffMemberId String
  fromStatus    EmploymentStatus
  toStatus      EmploymentStatus
  effectiveDate DateTime         @db.Date
  reason        String?          @db.Text
  recordedById  String
  createdAt     DateTime         @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  recordedBy  UserAccount @relation("StatusRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([staffMemberId, effectiveDate])
}

// ───────────────────────── Accounts, sessions, RBAC ─────────────────────────

model UserAccount {
  id                 String        @id @default(cuid())
  staffMemberId      String?       @unique // null only for non-staff system accounts
  passwordHash       String // Argon2id
  accountStatus      AccountStatus @default(PENDING_ACTIVATION)
  mustChangePassword Boolean       @default(true)
  failedLoginCount   Int           @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  sessions            Session[]
  resetTokens         PasswordResetToken[]
  roles               UserRole[]           @relation("RoleHolder")
  rolesGranted        UserRole[]           @relation("RoleGrantor")
  submittedRequests   ChangeRequest[]      @relation("RequestSubmitter")
  reviewedRequests    ChangeRequest[]      @relation("RequestReviewer")
  statusEvents        EmploymentStatusEvent[] @relation("StatusRecordedBy")
  observationsCreated LeaderObservation[]  @relation("ObsCreator")
  observationsUpdated LeaderObservation[]  @relation("ObsUpdater")
  observationRevisions ObservationRevision[]
  uploadedFiles       FileAsset[]          @relation("FileUploader")
  auditEvents         AuditEvent[]
  importBatches       ImportBatch[]        @relation("ImportCreator")
  importsAuthorised   ImportBatch[]        @relation("ImportLeaderAuth")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // SHA-256 of the opaque cookie token
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sliding-window login rate limiting. `key` is an HMAC of staffId/IP — never raw values.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. EMPLOYEE, HR_ADMIN, LEADER
  name        String
  isLeader    Boolean          @default(false) // Leader roles hold ONLY isLeader permissions
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id       String           @id @default(cuid())
  key      String           @unique // e.g. staff:read, observation:read
  isLeader Boolean          @default(false)
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  // Scope: null = institution-wide; otherwise limited to one department.
  departmentId String?
  grantedById  String
  grantedAt    DateTime @default(now())

  user       UserAccount @relation("RoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy  UserAccount @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  // Null-scope uniqueness is added as a partial index in db_guards.sql
  @@unique([userId, roleId, departmentId])
  @@index([userId])
}

// ───────────────────────── Change requests ─────────────────────────

model ChangeRequest {
  id              String        @id @default(cuid())
  staffMemberId   String
  submittedById   String
  status          RequestStatus @default(PENDING)
  baseVersion     Int // StaffMember.version when submitted; approval fails if stale
  note            String?       @db.Text
  rejectionReason String?       @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  staffMember StaffMember        @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  submittedBy UserAccount        @relation("RequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  UserAccount?       @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  items       ChangeRequestItem[]

  // At most one PENDING request per staff member: partial unique index in db_guards.sql
  @@index([status, createdAt])
  @@index([staffMemberId])
}

// Observation is deliberately NOT a valid target; allowed fieldKeys are an allowlist in Zod.
model ChangeRequestItem {
  id          String       @id @default(cuid())
  requestId   String
  target      ChangeTarget
  fieldKey    String // e.g. "mobile", "education.level", "experience.organization", "photo"
  recordId    String? // existing EducationRecord/ExperienceRecord id
  recordKey   String? // for new rows: education level or experience slot
  oldValue    Json?
  newValue    Json?
  photoFileId String?

  request   ChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  photoFile FileAsset?    @relation(fields: [photoFileId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

model FileAsset {
  id           String      @id @default(cuid())
  purpose      FilePurpose
  storageKey   String      @unique // path/key inside private storage — never a public URL
  mimeType     String
  sizeBytes    Int
  sha256       String
  ownerStaffId String?
  uploadedById String
  createdAt    DateTime    @default(now())

  ownerStaff  StaffMember?        @relation("FileOwner", fields: [ownerStaffId], references: [id], onDelete: Restrict)
  uploadedBy  UserAccount         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  asPhotoOf   StaffMember?        @relation("StaffPhoto")
  requestItems ChangeRequestItem[]
  importBatches ImportBatch[]

  @@index([ownerStaffId])
}

// ───────────────────────── Confidential observation ─────────────────────────

model LeaderObservation {
  id            String   @id @default(cuid())
  staffMemberId String   @unique
  body          String   @db.Text
  version       Int      @default(1) // optimistic concurrency + revision counter
  createdById   String
  updatedById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staffMember StaffMember           @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  createdBy   UserAccount           @relation("ObsCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   UserAccount           @relation("ObsUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  revisions   ObservationRevision[]
}

// Append-only (UPDATE/DELETE blocked by trigger).
model ObservationRevision {
  id            String   @id @default(cuid())
  observationId String
  version       Int
  body          String   @db.Text
  editedById    String
  createdAt     DateTime @default(now())

  observation LeaderObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  editedBy    UserAccount       @relation(fields: [editedById], references: [id], onDelete: Restrict)

  @@unique([observationId, version])
}

// ───────────────────────── Audit ─────────────────────────

// Append-only. `metadata` must never contain observation text or sensitive personal values.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "request.approve", "observation.update"
  entityType String
  entityId   String?
  metadata   Json? // ids, field KEYS, version numbers — not values of sensitive fields
  ipHash     String?
  createdAt  DateTime @default(now())

  actor UserAccount? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ───────────────────────── Excel import ─────────────────────────

model ImportBatch {
  id                 String       @id @default(cuid())
  fileAssetId        String
  originalName       String
  status             ImportStatus @default(UPLOADED)
  columnMapping      Json?
  includesObservations Boolean    @default(false)
  // Observation staging/commit requires a Leader who explicitly authorised this batch.
  leaderAuthorisedById String?
  totalRows          Int          @default(0)
  committedRows      Int          @default(0)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  fileAsset        FileAsset              @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdBy        UserAccount            @relation("ImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  leaderAuthorisedBy UserAccount?         @relation("ImportLeaderAuth", fields: [leaderAuthorisedById], references: [id], onDelete: Restrict)
  rows             ImportRow[]
  issues           ImportRowIssue[]
  observationRows  ImportObservationRow[]
}

model ImportRow {
  id             String          @id @default(cuid())
  batchId        String
  rowNumber      Int
  staffIdKey     String? // normalised staff ID used for duplicate detection
  data           Json // normalised profile data (no passwords, no observation)
  status         ImportRowStatus @default(PENDING)
  matchedStaffId String? // existing StaffMember.id when DUPLICATE/CONFLICT

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([batchId, staffIdKey])
}

// Confidential staging area for migrated observations. Leader-only access path.
model ImportObservationRow {
  id         String  @id @default(cuid())
  batchId    String
  rowNumber  Int
  staffIdKey String
  body       String  @db.Text
  committed  Boolean @default(false)

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
}

// Issues never embed cell values (they may be personal); only row/column/code.
model ImportRowIssue {
  id         String        @id @default(cuid())
  batchId    String
  rowNumber  Int?
  column     String?
  code       String // e.g. REQUIRED_MISSING, BAD_DATE, DUPLICATE_STAFF_ID, CONFLICT
  severity   IssueSeverity
  message    String
  createdAt  DateTime      @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
}
