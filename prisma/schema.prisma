generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  AUTHORITY
  COMPUTER_OPERATOR
  EMPLOYEE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(EMPLOYEE)
  active        Boolean  @default(true)
  employee      Employee?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auditEvents   AuditLog[] @relation("Actor")
}

model Employee {
  id                String   @id @default(cuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullNameEnglish   String   @default("")
  fullNameBangla    String?
  designation       String?
  employeeId        String?  @unique
  dateOfJoining     DateTime?
  position          String?
  department        String?
  supervisor        String?
  secondary         Json?
  higherSecondary   Json?
  graduation        Json?
  masters           Json?
  bed               Json?
  med               Json?
  ntrca             Json?
  otherTraining     Json?
  jobExperiences    Json?
  fatherName        String?
  motherName        String?
  dateOfBirth       DateTime?
  gender            String?
  bloodGroup        String?
  religion          String?
  maritalStatus     String?
  permanentAddress  String?
  presentAddress    String?
  nidPassport       String?
  homeDistrict      String?
  mobile            String?
  personalEmail     String?
  photoUrl          String?
  observations      Observation[]
  changeRequests    ChangeRequest[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([fullNameEnglish])
  @@index([department])
  @@index([designation])
}

model Observation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subject     String
  description String
  createdById String
  createdAt   DateTime @default(now())
}

model ChangeRequest {
  id             String        @id @default(cuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedById  String
  payload        Json
  status         RequestStatus @default(PENDING)
  reviewedById   String?
  reviewerNote   String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([createdAt])
}
